// Source of truth for the DB. See docs/data-schema-proposal.md for full design rationale
// (§13 is the authoritative MVP appendix this file mirrors; §14 is Phase 2, not applied here).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ── Identity ──────────────────────────────────────────────
model User {
  id           String      @id @default(cuid())
  email        String      @unique
  phone        String?     @unique
  passwordHash String?
  role         AccountRole @default(USER)
  isVerified   Boolean     @default(false)
  suspendedAt  DateTime?
  deletedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  profile                 Profile?
  subscriptions           Subscription[]
  sessions                Session[]
  reviewedSubmissions     EntitySubmission[]
  reviewedReports         Report[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  pushTokens              PushToken[]
  generationOperations    GenerationOperation[]
  adminAuditEvents        AdminAuditEvent[]
  membershipGrants        MembershipGrant[]        @relation("GrantRecipient")
  grantsIssued            MembershipGrant[]        @relation("GrantIssuedBy")
  grantsRevoked           MembershipGrant[]        @relation("GrantRevokedBy")
  couponRedemptions       CouponRedemption[]
}

enum AccountRole {
  USER
  MODERATOR
  ADMIN
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String   @default("expo")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model AdminAuditEvent {
  id            String   @id @default(cuid())
  actorUserId   String
  actorRole     AccountRole
  action        String
  targetType    String
  targetId      String?
  beforeValue   Json?
  afterValue    Json?
  metadata      Json?
  createdAt     DateTime @default(now())

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

// token is a short numeric code (mailed/emailed, entered by hand in-app — this is a
// mobile-only product with no web page to host a clickable reset link), scoped by
// userId rather than globally unique, so lookups are always `WHERE userId = X AND
// token = Y`. See AuthService for the actual comparison + expiry/used-once logic.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  token     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  username        String   @unique
  displayName     String
  birthdate       DateTime
  genderIdentity  String?
  // Baseline candidate-age eligibility (mutual, applied in both directions by
  // DiscoveryService) — not the same thing as the "20s/30s" Discover chips,
  // which only *narrow* this range, never replace it. No settings UI writes
  // these yet; the defaults are a deliberately wide no-op until one exists.
  preferredMinAge Int      @default(18)
  preferredMaxAge Int      @default(99)
  bio             String?  @db.VarChar(150)
  locationLat     Float?
  locationLng     Float?
  locationLabel   String?
  avatarUrl       String?
  isDiscoverable  Boolean  @default(true)
  onboardingStep  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user                   User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  seekingGenders         ProfileSeekingGender[]
  photos                 ProfilePhoto[]
  lists                  List[]
  submittedEntities      Entity[]
  submissions            EntitySubmission[]        @relation("SubmissionSubmitter")
  swipesMade             Swipe[]                   @relation("SwipeActor")
  swipesReceived         Swipe[]                   @relation("SwipeTarget")
  conversations          ConversationParticipant[]
  initiatedConversations Conversation[]            @relation("ConversationInitiator")
  sentMessages           Message[]                 @relation("MessageSender")
  blocksMade             Block[]                   @relation("BlockBlocker")
  blocksReceived         Block[]                   @relation("BlockBlocked")
  reportsFiled           Report[]                  @relation("ReportReporter")
  reportsReceived        Report[]                  @relation("ReportTargetProfile")
  quickPickSignals       QuickPickSignal[]

  @@index([locationLat, locationLng])
}

// ── Safety ────────────────────────────────────────────────
model Block {
  id               String   @id @default(cuid())
  blockerProfileId String
  blockedProfileId String
  createdAt        DateTime @default(now())

  blocker Profile @relation("BlockBlocker", fields: [blockerProfileId], references: [id], onDelete: Cascade)
  blocked Profile @relation("BlockBlocked", fields: [blockedProfileId], references: [id], onDelete: Cascade)

  @@unique([blockerProfileId, blockedProfileId])
  @@index([blockedProfileId])
}

enum ReportTargetType {
  PROFILE
  MESSAGE
}

enum ReportStatus {
  PENDING
  REVIEWED
  ACTIONED
}

model Report {
  id                String           @id @default(cuid())
  reporterProfileId String
  targetType        ReportTargetType
  targetProfileId   String?
  targetMessageId   String?
  reason            String
  details           String?          @db.Text
  status            ReportStatus     @default(PENDING)
  createdAt         DateTime         @default(now())
  reviewedAt        DateTime?
  reviewedByUserId  String?
  reviewNotes       String?          @db.Text

  reporter       Profile  @relation("ReportReporter", fields: [reporterProfileId], references: [id], onDelete: Restrict)
  targetProfile  Profile? @relation("ReportTargetProfile", fields: [targetProfileId], references: [id], onDelete: Restrict)
  targetMessage  Message? @relation("ReportTargetMessage", fields: [targetMessageId], references: [id], onDelete: Restrict)
  reviewedByUser User?    @relation(fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([targetProfileId])
}

model ProfileSeekingGender {
  profileId String
  gender    String

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, gender])
}

model ProfilePhoto {
  id        String   @id @default(cuid())
  profileId String
  url       String
  sortOrder Int
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, sortOrder])
}

// ── Matching ──────────────────────────────────────────────
model Swipe {
  id              String      @id @default(cuid())
  actorProfileId  String
  targetProfileId String
  action          SwipeAction
  createdAt       DateTime    @default(now())

  actor  Profile @relation("SwipeActor", fields: [actorProfileId], references: [id], onDelete: Cascade)
  target Profile @relation("SwipeTarget", fields: [targetProfileId], references: [id], onDelete: Cascade)

  @@unique([actorProfileId, targetProfileId])
  @@index([targetProfileId])
}

enum SwipeAction {
  LIKE
  PASS
}

// ── Taxonomy ──────────────────────────────────────────────
model EntityType {
  id             String   @id @default(cuid())
  slug           String   @unique
  label          String
  pluralLabel    String
  icon           String?
  metadataSchema Json?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  categoryDrafts    CategoryDraft[]
  entities          Entity[]
  categories        Category[]
  entitySubmissions EntitySubmission[]
  mediaAssets       MediaAsset[]

  parentId String?
  parent   EntityType?  @relation("TypeHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children EntityType[] @relation("TypeHierarchy")
}

model Entity {
  id                   String           @id @default(cuid())
  entityTypeId         String
  canonicalName        String
  slug                 String
  imageUrl             String?
  metadata             Json?
  externalIds          Json?
  sourceType           EntitySourceType @default(SEEDED)
  status               SubmissionStatus @default(APPROVED)
  mergedIntoId         String?
  usageCount           Int              @default(0)
  submittedByProfileId String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  entityType           EntityType         @relation(fields: [entityTypeId], references: [id], onDelete: Restrict)
  mergedInto           Entity?            @relation("EntityMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom           Entity[]           @relation("EntityMerge")
  submittedByProfile   Profile?           @relation(fields: [submittedByProfileId], references: [id], onDelete: SetNull)
  aliases              EntityAlias[]
  tags                 EntityTag[]
  listItems            ListItem[]
  submittedEntityFor   EntitySubmission?  @relation("SubmissionSubmittedEntity")
  suggestedMatchFor    EntitySubmission[] @relation("SubmissionSuggestedMatch")
  resolvedFor          EntitySubmission[] @relation("SubmissionResolvedEntity")
  topPickForCategories Category[]         @relation("CategoryTopPick")
  quickPickSignal1     QuickPickSignal[]  @relation("QuickPickEntity1")
  quickPickSignal2     QuickPickSignal[]  @relation("QuickPickEntity2")
  quickPickWins        QuickPickSignal[]  @relation("QuickPickWinnerSignal")
  quickPickLosses      QuickPickSignal[]  @relation("QuickPickLoserSignal")
  parentCategories     Category[]         @relation("CategoryParentEntity")
  curatedForCategories CategoryEntity[]
  mediaAssets          MediaAsset[]
  externalRefs         EntityExternalRef[]
  candidates           EntityCandidate[]
  facets               EntityFacet[]

  parentId String?
  parent   Entity?  @relation("EntityHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Entity[] @relation("EntityHierarchy")

  @@unique([entityTypeId, slug])
  @@index([entityTypeId, status])
  @@index([entityTypeId, usageCount])
  @@index([canonicalName])
}

model EntityExternalRef {
  id         String   @id @default(cuid())
  entityId   String
  provider   String
  externalId String
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, provider])
  @@index([provider, externalId])
}

model MediaAsset {
  id              String   @id @default(cuid())
  entityId        String?
  entityTypeId    String?
  categoryId      String?
  sourceType      String
  provider        String?
  sourceId        String?
  sourceUrl       String?  @db.Text
  landingUrl      String?  @db.Text
  creator         String?
  license         String?
  licenseUrl      String?  @db.Text
  attribution     String?  @db.Text
  importRule      String   @default("REVIEW_REQUIRED")
  originalWidth   Int?
  originalHeight  Int?
  crop            Json?
  storageKey      String?
  publicUrl       String?
  mimeType        String?
  byteSize        Int?
  sha256          String?
  metadata        Json?
  isPrimary       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  entity     Entity?     @relation(fields: [entityId], references: [id], onDelete: Cascade)
  entityType EntityType? @relation(fields: [entityTypeId], references: [id], onDelete: Cascade)
  category   Category?   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([entityId, isPrimary])
  @@index([entityTypeId, isPrimary])
  @@index([categoryId, isPrimary])
  @@index([provider, sourceId])
}

enum EntitySourceType {
  SEEDED
  IMPORTED
  USER_SUBMITTED
  AI_GENERATED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  MERGED
}

model EntityAlias {
  id        String   @id @default(cuid())
  entityId  String
  alias     String
  locale    String   @default("en")
  createdAt DateTime @default(now())

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, alias])
  @@index([alias])
}

model Tag {
  id        String   @id @default(cuid())
  slug      String   @unique
  label     String
  kind      TagKind  @default(CUSTOM)
  createdAt DateTime @default(now())

  entityTags   EntityTag[]
  categoryTags CategoryTag[]
}

enum TagKind {
  DECADE
  GENRE
  PLATFORM
  REGION
  ERA
  CUSTOM
}

model EntityTag {
  entityId String
  tagId    String

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([entityId, tagId])
}

model EntitySubmission {
  id                   String           @id @default(cuid())
  entityTypeId         String
  rawText              String
  submittedByProfileId String?
  submittedEntityId    String           @unique
  suggestedMatchId     String?
  resolvedEntityId     String?
  status               SubmissionStatus @default(PENDING)
  reviewedByUserId     String?
  reviewNotes          String?
  createdAt            DateTime         @default(now())
  reviewedAt           DateTime?

  entityType         EntityType @relation(fields: [entityTypeId], references: [id], onDelete: Restrict)
  submittedByProfile Profile?   @relation("SubmissionSubmitter", fields: [submittedByProfileId], references: [id], onDelete: Restrict)
  submittedEntity    Entity     @relation("SubmissionSubmittedEntity", fields: [submittedEntityId], references: [id], onDelete: Restrict)
  suggestedMatch     Entity?    @relation("SubmissionSuggestedMatch", fields: [suggestedMatchId], references: [id], onDelete: SetNull)
  resolvedEntity     Entity?    @relation("SubmissionResolvedEntity", fields: [resolvedEntityId], references: [id], onDelete: SetNull)
  reviewedByUser     User?      @relation(fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([status, entityTypeId])
}

// ── Categories & Lists ────────────────────────────────────
model CategoryGroup {
  id        String   @id @default(cuid())
  slug      String   @unique
  label     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  categories Category[]
  categoryDrafts CategoryDraft[]
}

model Category {
  id              String           @id @default(cuid())
  groupId         String
  entityTypeId    String
  slug            String           @unique
  prompt          String
  shortLabel      String
  minItems        Int              @default(1)
  maxItems        Int              @default(5)
  orderingMode    OrderingMode     @default(RANKED)
  isMatchSignal   Boolean          @default(true)
  isPremiumOnly   Boolean          @default(false)
  isActive        Boolean          @default(true)
  poolMode        String         @default("FILTERED")
  authoringDraft  CategoryDraft?
  popularityCount Int              @default(0)
  parentEntityId  String?
  topPickEntityId String?
  metadata        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  group            CategoryGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  entityType       EntityType    @relation(fields: [entityTypeId], references: [id], onDelete: Restrict)
  parentEntity     Entity?       @relation("CategoryParentEntity", fields: [parentEntityId], references: [id], onDelete: SetNull)
  topPickEntity    Entity?       @relation("CategoryTopPick", fields: [topPickEntityId], references: [id], onDelete: SetNull)
  requiredTags     CategoryTag[]
  curatedEntities  CategoryEntity[]
  lists            List[]
  mediaAssets      MediaAsset[]
  sitePickItems    SitePickItem[]

  @@index([groupId])
  @@index([isActive])
  @@index([entityTypeId])
  @@index([parentEntityId])
}

enum OrderingMode {
  RANKED
  UNRANKED
}

model CategoryTag {
  categoryId String
  tagId      String

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([categoryId, tagId])
}

model CategoryEntity {
  categoryId String
  entityId   String
  sortOrder  Int      @default(0)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  entity   Entity   @relation(fields: [entityId], references: [id], onDelete: Restrict)

  @@id([categoryId, entityId])
}

// Admin-curated "Site Picks" — 12 groups of 4 existing List Definitions
// (Category rows) each, surfaced as their own Grid modules in the Lists feed
// (ContentFeedService.getListsFeed), immediately after "Your lists" and
// before the first Quick Picks beat. References existing Category rows
// rather than duplicating them — a category can appear in multiple groups.
model SitePickGroup {
  id        String   @id @default(cuid())
  slug      String   @unique
  label     String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items SitePickItem[]
}

model SitePickItem {
  groupId    String
  categoryId String
  sortOrder  Int    @default(0)

  group    SitePickGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  category Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([groupId, categoryId])
  @@index([categoryId])
}

model List {
  id          String         @id @default(cuid())
  profileId   String
  categoryId  String
  title       String?
  visibility  ListVisibility @default(PUBLIC)
  isComplete  Boolean        @default(false)
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  profile  Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  category Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  items    ListItem[]

  @@unique([profileId, categoryId])
  @@index([profileId])
  @@index([categoryId])
}

enum ListVisibility {
  PUBLIC
  PREMIUM_ONLY
  PRIVATE
}

model ListItem {
  id        String   @id @default(cuid())
  listId    String
  entityId  String
  rank      Int
  note      String?
  createdAt DateTime @default(now())

  list   List   @relation(fields: [listId], references: [id], onDelete: Cascade)
  entity Entity @relation(fields: [entityId], references: [id], onDelete: Restrict)

  @@unique([listId, rank])
  @@unique([listId, entityId])
  @@index([entityId])
}

enum QuickPickContextType {
  CATEGORY
  ENTITY_TYPE
  PARENT_ENTITY
  TAG
}

model QuickPickSignal {
  id        String @id @default(cuid())
  profileId String

  contextType QuickPickContextType
  contextId   String

  entity1Id String
  entity2Id String

  winnerId String
  loserId  String

  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  entity1 Entity  @relation("QuickPickEntity1", fields: [entity1Id], references: [id], onDelete: Cascade)
  entity2 Entity  @relation("QuickPickEntity2", fields: [entity2Id], references: [id], onDelete: Cascade)
  winner  Entity  @relation("QuickPickWinnerSignal", fields: [winnerId], references: [id], onDelete: Cascade)
  loser   Entity  @relation("QuickPickLoserSignal", fields: [loserId], references: [id], onDelete: Cascade)

  @@index([profileId, contextType, contextId])
  @@index([profileId, entity1Id, entity2Id])
}

// ── Messaging ─────────────────────────────────────────────
model Conversation {
  id            String             @id @default(cuid())
  status        ConversationStatus @default(ACCEPTED)
  initiatedById String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  initiator    Profile                   @relation("ConversationInitiator", fields: [initiatedById], references: [id], onDelete: Restrict)
  participants ConversationParticipant[]
  messages     Message[]
}

enum ConversationStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

model ConversationParticipant {
  conversationId String
  profileId      String
  lastReadAt     DateTime?
  isArchived     Boolean   @default(false)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  profile      Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([conversationId, profileId])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String?   @db.Text
  attachments    Json?
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Profile      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  reports      Report[]     @relation("ReportTargetMessage")

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

// ── Monetization ──────────────────────────────────────────
model Plan {
  id         String       @id @default(cuid())
  slug       String       @unique
  label      String
  interval   PlanInterval
  priceCents Int
  currency   String       @default("USD")
  isActive   Boolean      @default(true)

  subscriptions Subscription[]
  grants        MembershipGrant[]
}

enum PlanInterval {
  MONTHLY
  ANNUAL
  LIFETIME
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String
  planId                 String
  provider               PaymentProvider
  providerSubscriptionId String             @unique
  status                 SubscriptionStatus
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean            @default(false)
  // Snapshot of MEMBER entitlement policy values at creation (Phase 7
  // grandfathering) — a later policy *reduction* never silently takes away
  // what this subscription already promised; a policy *improvement* still
  // flows through live. Null on rows created before this existed — see
  // the Phase 7 migration script, which backfills it for then-active rows.
  entitlementFloor       Json?
  // Snapshot of Plan.priceCents at the moment this subscription was created
  // — an admin repricing the plan afterward never silently changes what an
  // existing subscriber is considered to be paying. Null on rows created
  // before this existed (see the Phase 7.1 migration script backfill).
  pricePaidCents         Int?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, status])
}

enum PaymentProvider {
  APPLE_APP_STORE
  GOOGLE_PLAY
  STRIPE
  MANUAL
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  EXPIRED
}

// ── Supporting site ───────────────────────────────────────
model WaitlistSignup {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?
  createdAt DateTime @default(now())
}

// ── Worker & Matching Pipeline ────────────────────────────
model JobQueue {
  id          String    @id @default(cuid())
  type        String
  version     Int       @default(1)
  payload     Json
  status      JobStatus @default(PENDING)
  lockedAt    DateTime?
  lockedBy    String?
  attempts    Int       @default(0)
  lastError   String?   @db.Text
  availableAt DateTime  @default(now())
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, availableAt, lockedAt])
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

model CompatibilityScore {
  id               String   @id @default(cuid())
  profileIdA       String
  profileIdB       String
  score            Float
  sharedItemsCount Int
  sharedFavorites  Json
  insights         Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([profileIdA, profileIdB])
  @@index([profileIdA, score(sort: Desc)])
  @@index([profileIdB, score(sort: Desc)])
}

// ── Membership (Phase 7) ──────────────────────────────────
// FREE and MEMBER remain the only product states (see lib/entitlements.ts).
// Plan/Subscription above stay real billing infrastructure, unchanged.
// Everything below is how a user *becomes* MEMBER without a live paid
// subscription, and how the entitlement policy itself is administered.

// Admin-editable FREE/MEMBER feature policy — one row per (state, key). Falls
// back to ENTITLEMENT_DEFAULTS in code for any (state, key) with no row yet,
// so the system works before the table is ever seeded/edited.
model EntitlementPolicy {
  id              String           @id @default(cuid())
  state           MembershipState
  key             String
  value           Json
  updatedAt       DateTime         @updatedAt
  updatedByUserId String?

  @@unique([state, key])
}

enum MembershipState {
  FREE
  MEMBER
}

// Independent of Subscription — the sole non-billing path to MEMBER.
// Lifetime when expiresAt is null. Always confers MEMBER (the only two
// states are FREE/MEMBER, so there's nothing else for a grant to confer).
model MembershipGrant {
  id                 String     @id @default(cuid())
  userId             String
  source             GrantSource
  reason             String?
  expiresAt          DateTime?
  // Snapshot of MEMBER entitlement policy values at creation — same
  // grandfathering floor as Subscription.entitlementFloor.
  entitlementFloor   Json?
  revokedAt          DateTime?
  revokedByUserId    String?
  revokeReason       String?
  grantedByUserId    String?
  signupPromotionId  String?
  couponRedemptionId String?    @unique
  // Only set when source is ONE_TIME_PURCHASE — a lifetime/one-time plan
  // "purchase" is a license, not recurring billing, so it never creates a
  // Subscription row; this is its equivalent price-paid snapshot instead
  // (same grandfathering intent as Subscription.pricePaidCents).
  planId             String?
  pricePaidCentsSnapshot Int?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  user             User              @relation("GrantRecipient", fields: [userId], references: [id], onDelete: Cascade)
  grantedByUser    User?             @relation("GrantIssuedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  revokedByUser    User?             @relation("GrantRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  signupPromotion  SignupPromotion?  @relation(fields: [signupPromotionId], references: [id], onDelete: SetNull)
  couponRedemption CouponRedemption? @relation(fields: [couponRedemptionId], references: [id], onDelete: SetNull)
  plan             Plan?             @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@index([source])
}

enum GrantSource {
  MANUAL_ADMIN
  SIGNUP_PROMOTION
  COUPON_REDEMPTION
  ONE_TIME_PURCHASE
}

// [startAt, endAt) — a user who *registers* inside this window is granted
// MEMBER (lifetime, or temporary for durationDays). Distinct from
// GlobalMembershipWindow below, which elevates every existing user for a
// stretch of time regardless of when they signed up.
model SignupPromotion {
  id              String           @id @default(cuid())
  label           String
  startAt         DateTime
  endAt           DateTime
  awardType       SignupAwardType
  durationDays    Int?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  createdByUserId String?

  grants MembershipGrant[]

  @@index([isActive, startAt, endAt])
}

enum SignupAwardType {
  LIFETIME_MEMBER
  TEMPORARY_MEMBER
}

// [startAt, endAt) — every user (new or existing) resolves as MEMBER while
// now() falls in this window, with no per-user grant row created (see
// resolveMembership). Purely a temporary global promotional elevation.
model GlobalMembershipWindow {
  id              String   @id @default(cuid())
  label           String
  startAt         DateTime
  endAt           DateTime
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  createdByUserId String?

  @@index([isActive, startAt, endAt])
}

model CouponCode {
  id                    String       @id @default(cuid())
  code                  String       @unique
  discountType          DiscountType
  discountPercent       Int
  // Only meaningful for a FULL (100%) coupon's resulting grant — null means
  // lifetime MEMBER, otherwise the grant expires this many days after redemption.
  grantDurationDays     Int?
  campaign              String?
  partner               String?
  maxRedemptions        Int?
  maxRedemptionsPerUser Int          @default(1)
  startAt               DateTime?
  endAt                 DateTime?
  isActive              Boolean      @default(true)
  createdAt             DateTime     @default(now())
  createdByUserId       String?

  redemptions CouponRedemption[]

  @@index([isActive])
}

enum DiscountType {
  PERCENTAGE
  FULL
}

// Immutable terms/history: a snapshot of the coupon's terms *as redeemed*,
// so a later edit to CouponCode never rewrites what a past redemption
// actually granted. A FULL (100%) redemption gets a MembershipGrant
// (see the 1:1 relation on MembershipGrant.couponRedemptionId); a
// PERCENTAGE redemption is recorded for attribution/history only — it
// requires verified payment before it grants any access, which is out of
// scope until real IAP exists.
model CouponRedemption {
  id                        String       @id @default(cuid())
  couponCodeId              String
  userId                    String
  codeSnapshot              String
  discountType              DiscountType
  discountPercent           Int
  grantDurationDaysSnapshot Int?
  campaignSnapshot          String?
  partnerSnapshot           String?
  redeemedAt                DateTime     @default(now())

  couponCode CouponCode       @relation(fields: [couponCodeId], references: [id], onDelete: Restrict)
  user       User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  grant      MembershipGrant?

  @@index([userId])
  @@index([couponCodeId])
}

// Private authoring objects. Concepts are creative seeds, not public taxonomy.
model Concept {
  id     String          @id @default(cuid())
  key    String          @unique
  label  String
  status String          @default("NEW")
  drafts CategoryDraft[]
}

model GenerationOperation {
  id                String            @id @default(cuid())
  kind              String
  targetId          String?
  input             Json
  model             String
  systemPrompt      String            @db.Text
  userPrompt        String            @db.Text
  promptVersion     String
  status            String            @default("PENDING")
  output            Json?
  error             String?           @db.Text
  requestedByUserId String
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime          @default(now())
  requestedBy       User              @relation(fields: [requestedByUserId], references: [id], onDelete: Restrict)
  drafts            CategoryDraft[]
  candidates        EntityCandidate[]
  facets            EntityFacet[]

  @@index([status, createdAt])
}

model CategoryDraft {
  id                    String              @id @default(cuid())
  conceptId             String
  generationOperationId String
  title                 String
  slug                  String
  prompt                String              @db.Text
  entityTypeId          String?
  groupId               String?
  rules                 Json
  approvalState         String              @default("DRAFT")
  publishedCategoryId   String?             @unique
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  concept               Concept             @relation(fields: [conceptId], references: [id], onDelete: Restrict)
  operation             GenerationOperation @relation(fields: [generationOperationId], references: [id], onDelete: Restrict)
  entityType            EntityType?         @relation(fields: [entityTypeId], references: [id], onDelete: Restrict)
  group                 CategoryGroup?      @relation(fields: [groupId], references: [id], onDelete: Restrict)
  publishedCategory     Category?           @relation(fields: [publishedCategoryId], references: [id], onDelete: Restrict)
  candidates            EntityCandidate[]

  @@unique([conceptId, slug])
  @@index([conceptId, createdAt])
}

model EntityCandidate {
  id                    String              @id @default(cuid())
  categoryDraftId       String
  generationOperationId String
  name                  String
  slug                  String
  details               String              @db.Text
  resolutionState       String              @default("UNRESOLVED")
  resolvedEntityId      String?
  reviewState           String              @default("PENDING")
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  draft                 CategoryDraft       @relation(fields: [categoryDraftId], references: [id], onDelete: Cascade)
  operation             GenerationOperation @relation(fields: [generationOperationId], references: [id], onDelete: Restrict)
  entity                Entity?             @relation(fields: [resolvedEntityId], references: [id], onDelete: Restrict)

  @@unique([categoryDraftId, slug])
}

model EntityFacet {
  id                    String               @id @default(cuid())
  entityId              String
  axis                  String               @db.VarChar(60)
  value                 String               @db.VarChar(120)
  source                String
  generationOperationId String?
  entity                Entity               @relation(fields: [entityId], references: [id], onDelete: Cascade)
  operation             GenerationOperation? @relation(fields: [generationOperationId], references: [id], onDelete: Restrict)

  @@unique([entityId, axis, value])
}
