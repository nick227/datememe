# Database
DATABASE_URL=mysql://root:NEW_ROOT_PASSWORD@localhost:3306/datememe_dev

# Server
PORT=3002
SESSION_SECRET=change-me-in-production
# Comma-separated allowlist of origins allowed to call this API with
# credentials (cookies) — covers the mobile app's web preview in local dev.
# Leaving this unset makes the server reflect any request origin, which is
# fine for a quick local run but not for a real deployment.
CORS_ORIGIN=http://localhost:8081
BASE_URL=http://localhost:3002

# File uploads (file-upload plugin) — local | r2 | s3, defaults to local, no keys needed
STORAGE_PROVIDER=local
# Hosted API: mount a Railway volume at /data and set UPLOADS_DIR=/data/uploads.
# Local development defaults to apps/server/uploads when unset.
# UPLOADS_DIR=/data/uploads
UPLOAD_MAX_SIZE_MB=10

# Mobile (Expo) — apps/mobile/.env, read via EXPO_PUBLIC_ prefix
EXPO_PUBLIC_API_URL=http://localhost:3002
