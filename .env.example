# Database
DATABASE_URL=mysql://root:NEW_ROOT_PASSWORD@localhost:3306/datememe_dev

# Server
PORT=3002
SESSION_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:8081
BASE_URL=http://localhost:3002

# File uploads (file-upload plugin) — local | r2 | s3, defaults to local, no keys needed
STORAGE_PROVIDER=local
UPLOAD_MAX_SIZE_MB=10

# Mobile (Expo) — apps/mobile/.env, read via EXPO_PUBLIC_ prefix
EXPO_PUBLIC_API_URL=http://localhost:3002
