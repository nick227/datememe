{
  "name": "datememe",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --filter @project/db db:push && pnpm --filter './packages/*' build && pnpm --filter './apps/*' build",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "pnpm --recursive lint",
    "test": "pnpm --recursive test",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "sdk:generate": "pnpm --filter @project/sdk generate",
    "sdk:check": "tsx scripts/check-sdk-drift.ts",
    "db:push": "pnpm --filter @project/db db:push",
    "db:seed": "pnpm --filter @project/db db:seed",
    "db:studio": "pnpm --filter @project/db db:studio",
    "db:migrate:dev": "pnpm --filter @project/db db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @project/db db:migrate:deploy",
    "db:migrate:status": "pnpm --filter @project/db db:migrate:status",
    "db:migrate:baseline": "pnpm --filter @project/db db:migrate:baseline"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.0",
    "js-yaml": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.3",
      "react-dom": "19.2.3"
    }
  },
  "packageManager": "pnpm@10.12.1+sha512.f0dda8580f0ee9481c5c79a1d927b9164f2c478e90992ad268bbb2465a736984391d6333d2c327913578b2804af33474ca554ba29c04a8b13060a717675ae3ac"
}
