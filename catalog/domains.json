{
  "$comment": "Coverage targets for catalog:audit (apps/worker/src/scripts/catalog-audit.ts). A list counts toward a domain when its group is listed or its title/question/value type contains a keyword as a whole word or phrase (a plain -s/-es plural counts; \"bar\" never matches \"barbecue\"). exclude lists phrases that use a keyword in another sense and are ignored (\"pet peeve\" isn't about pets). min = fewer lists is 'thin'; maxShare = a larger share of all active lists is 'overrepresented'. Source: docs/catalog-gap-audit.md. 2026-09-29: mins raised for the domains with the most matchmaking signal (values, dating, money, home, social, routines, humor, pets) once every domain met its first target.",
  "media": { "label": "Media (film, TV, music, creators, podcasts, games, books)", "groups": ["film-tv", "music", "creators", "podcasts", "gaming", "literature"], "maxShare": 0.4 },
  "dating": { "label": "Dating & relationships", "groups": ["dating-relationships"], "keywords": ["date", "dating", "relationship", "partner", "romantic"], "min": 10 },
  "social-habits": { "label": "Social habits", "keywords": ["party", "friends", "texting", "group chat", "plans", "social", "hang out"], "exclude": ["social media"], "min": 6 },
  "daily-routines": { "label": "Daily routines", "keywords": ["morning", "sunday", "sleep", "late-night", "routine", "commute", "breakfast", "bedtime"], "min": 6 },
  "home-living": { "label": "Home & living", "keywords": ["home", "house", "houseplant", "cleaning", "apartment", "interior", "decor", "household", "chore"], "min": 6 },
  "nightlife": { "label": "Nightlife & going out", "keywords": ["bar", "night out", "karaoke", "beer", "wine", "cocktail", "club", "nightlife"], "exclude": ["candy bar"], "min": 4 },
  "humor": { "label": "Humor", "keywords": ["humor", "humour", "funny", "comedian", "comedy", "joke", "meme", "sitcom"], "min": 5 },
  "values": { "label": "Values & priorities", "keywords": ["green flag", "red flag", "dealbreaker", "priority", "priorities", "life goal", "values"], "min": 7 },
  "pets": { "label": "Pets & animals", "keywords": ["pet", "dog", "cat", "animal"], "exclude": ["pet peeve"], "min": 4 },
  "money": { "label": "Money & spending", "keywords": ["money", "spend", "splurge", "saving", "budget"], "exclude": ["spend time"], "min": 5 },
  "wellness": { "label": "Wellness & self-care", "keywords": ["wellness", "self-care", "unwind", "relax", "meditation", "meditate"], "min": 3 },
  "travel": { "label": "Travel", "groups": ["travel"], "keywords": ["travel", "trip", "vacation", "destination"], "min": 5 },
  "seasons-holidays": { "label": "Seasons & holidays", "keywords": ["season", "holiday", "summer", "winter", "christmas", "time of year"], "min": 3 },
  "food-drink": { "label": "Food & drink", "groups": ["food-drink"], "min": 8, "maxShare": 0.15 },
  "sports-fitness": { "label": "Sports & fitness", "groups": ["sports"], "keywords": ["gym", "workout", "fitness"], "min": 4 },
  "career-tech": { "label": "Career & tech", "groups": ["career", "tech"], "min": 3 },
  "substances": { "label": "Substances & vices", "groups": ["substances"], "keywords": ["substance", "drug", "psychedelic", "sober", "drinking", "smoke", "cannabis"], "min": 4 }
}
