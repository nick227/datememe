# Expo inlines EXPO_PUBLIC_-prefixed vars at build time. Copy this to .env.
#
# - iOS simulator / Expo web: http://localhost:3002 works as-is.
# - Android emulator: use http://10.0.2.2:3002 instead (emulator's alias for the host).
# - Physical device (Expo Go): use your machine's LAN IP, e.g. http://192.168.1.23:3002.
# Port 3002, not 3001 — 3001 is occupied by an unrelated project on this machine.
EXPO_PUBLIC_API_URL=http://localhost:3002
