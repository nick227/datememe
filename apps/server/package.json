{
  "name": "server",
  "version": "0.0.1",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && mkdir -p dist/prompts/catalog && cp src/prompts/catalog/*.md dist/prompts/catalog/",
    "start": "node dist/index.js",
    "test": "vitest run",
    "seed:taxonomy-media": "tsx src/scripts/seed-taxonomy-media.ts",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no lint configured for server'",
    "prompt:preview": "tsx src/scripts/preview-catalog-prompt.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.4",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@project/db": "workspace:*",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.5",
    "fastify-openapi-glue": "^4.6.0",
    "fastify-plugin": "^6.0.0",
    "js-yaml": "^5.4.2",
    "openai": "^7.22.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^26.6.2",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
