{
  "name": "server",
  "version": "0.0.1",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && mkdir -p dist/prompts/catalog && cp src/prompts/catalog/*.md dist/prompts/catalog/",
    "start": "node dist/index.js",
    "test": "vitest run",
    "catalog:validate": "tsx src/scripts/catalog-publish.ts --dry-run",
    "catalog:publish": "tsx src/scripts/catalog-publish.ts",
    "media:identify": "tsx src/scripts/media-identify.ts",
    "covers:propose": "tsx src/scripts/covers-propose.ts",
    "covers:backfill": "tsx src/scripts/covers-auto.ts backfill",
    "covers:improve": "tsx src/scripts/covers-auto.ts improve",
    "media:sync": "tsx src/scripts/media-sync.ts",
    "derived:enqueue": "tsx src/scripts/derived-enqueue.ts",
    "audit:media": "tsx src/scripts/audit-media.ts",
    "repair:taxonomy-media": "tsx src/scripts/repair-taxonomy-media.ts",
    "verify:media-fixtures": "tsx src/scripts/verify-media-fixtures.ts",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no lint configured for server'",
    "prompt:preview": "tsx src/scripts/preview-catalog-prompt.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^10.1.8",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@project/db": "workspace:*",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.7",
    "fastify-openapi-glue": "^4.12.0",
    "fastify-plugin": "^6.0.1",
    "js-yaml": "^5.5.0",
    "openai": "^7.45.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^26.6.5",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
