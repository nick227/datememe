{
  "name": "server",
  "version": "0.0.1",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && mkdir -p dist/prompts/catalog && cp src/prompts/catalog/*.md dist/prompts/catalog/",
    "start": "node dist/index.js",
    "test": "vitest run",
    "seed:taxonomy-media": "tsx src/scripts/seed-taxonomy-media.ts",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no lint configured for server'",
    "prompt:preview": "tsx src/scripts/preview-catalog-prompt.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/static": "^7.0.4",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@project/db": "workspace:*",
    "bcryptjs": "^2.4.3",
    "fastify": "^4.28.0",
    "fastify-openapi-glue": "^4.6.0",
    "fastify-plugin": "^4.5.1",
    "js-yaml": "^4.1.0",
    "openai": "^7.20.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^20.0.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
